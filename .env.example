# ─────────────────────────────────────────────────────────────────────────────
# STS Lab: Gemini 3.8 Live Speech-to-Speech Architecture Configuration
# Copy this file to .env and insert your LiveKit Cloud and Gemini API keys.
# ─────────────────────────────────────────────────────────────────────────────

# LiveKit Cloud Credentials (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key

# STS Settings
STS_AGENT_NAME=sts-simran
STS_MODEL=gemini-3.8-live
STS_VOICE=Leda
STS_PORT=8001

# Conversation persistence + admin dashboard
# Local dev default is a SQLite file. In production use PostgreSQL, for example:
#   DATABASE_URL=postgresql://user:password@host:5432/roxstar_sts
DATABASE_URL=sqlite+aiosqlite:///./sts_lab.db
# Set to false to disable all conversation logging (voice agent works exactly as before)
STS_DB_ENABLED=true
# Leave EMPTY in development: the /admin dashboard then opens without a key, but only for
# requests from this same machine. SET IT to a long random value before the server is reachable
# from outside (staging, production).
ADMIN_API_KEY=
