# ─────────────────────────────────────────────────────────────────────────────
# STS Lab: Gemini 3.8 Live Speech-to-Speech Architecture Configuration
# Copy this file to .env and insert your LiveKit Cloud and Gemini API keys.
# ─────────────────────────────────────────────────────────────────────────────

# LiveKit Cloud Credentials (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key

# STS Settings
STS_AGENT_NAME=sts-simran
STS_MODEL=gemini-3.8-live
STS_VOICE=Leda
STS_PORT=8001

# Conversation persistence + admin dashboard
# Local dev default is a SQLite file. In production use PostgreSQL, for example:
#   DATABASE_URL=postgresql://user:password@host:5432/roxstar_sts
DATABASE_URL=sqlite+aiosqlite:///./sts_lab.db
# Set to false to disable all conversation logging (voice agent works exactly as before)
STS_DB_ENABLED=true
# Leave EMPTY in development: the /admin dashboard then opens without a key, but only for
# requests from this same machine. SET IT to a long random value before the server is reachable
# from outside (staging, production).
ADMIN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# RoxStar integration (Simran onboarding). Everything here is OFF / empty by default,
# so the standalone lab behaves exactly as before. Placeholders only: never commit real values.
# ─────────────────────────────────────────────────────────────────────────────
# "standalone" (default) = lab mode, anyone can get a token.
# "roxstar" = only logged-in RoxStar users, each in their own private room.
STS_AUTH_MODE=
# The secret RoxStar Auth signs login tokens with. Used ONLY to verify them. Required when STS_AUTH_MODE=roxstar.
JWT_API_KEY=
# Most Simran conversations allowed at the same time (protects Gemini / LiveKit cost). Default 50. 0 = no cap.
STS_MAX_CONCURRENT_SESSIONS=
# New Simran sessions one user may start per hour. Default 3. 0 = no limit.
STS_USER_SESSIONS_PER_HOUR=
# Seconds before Simran wraps up a conversation. Default 480 (8 min). 0 = no limit.
STS_MAX_SESSION_SEC=
# rox-partyroom base URL, for the live duet list. Empty = Simran offers solo recording only.
PARTYROOM_BASE_URL=
# rox-chat base URL, to cancel the 2-minute popup once a user opens Simran. Empty = skipped.
CHAT_BASE_URL=
# Shared secret for Simran's calls to rox-partyroom and rox-chat. Must differ from every other secret.
SIMRAN_INTERNAL_SECRET=
